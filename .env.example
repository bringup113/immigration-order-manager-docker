# 对外访问端口。不填写时使用 3000。
APP_PORT=3000
# 默认仅本机可访问；需要局域网访问时，填写这台机器当前的固定内网 IP。
# 不建议填写 0.0.0.0，因为它也会监听 VPN 等其他网络接口。
APP_BIND_ADDRESS=127.0.0.1

# 仅在配合 docker-compose.nas.yml 时使用：应用要绑定的 NAS 内网地址。
# 浏览器的内网访问地址由它和 APP_PORT 组成，例如 http://192.168.3.13:3000。
NAS_BIND_ADDRESS=192.168.3.13

# 可选：自行指定登录密钥。不填写时，容器首次启动会自动生成并保存。
APP_AUTH_SECRET=

# 公网部署时填写唯一的正式 HTTPS 来源，包含实际端口但不能包含路径。
# 示例：https://order.example.com:8888
# 不要在这里填写内网地址或同时填写多个地址；同源内网访问会按请求 Host 自动放行。
APP_ORIGIN=
PUBLIC_DEPLOYMENT=0
# 变量名为兼容旧版本保留；当前策略只强制系统所有者启用 MFA。
REQUIRE_PRIVILEGED_MFA=0

# 登录会话：连续未使用 60 分钟或登录满 12 小时后失效；已撤销记录保留 30 天。
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
SESSION_RETENTION_DAYS=30

# 本地 PostgreSQL。只映射到 127.0.0.1，不向局域网或公网开放。
POSTGRES_DB=migra
POSTGRES_USER=migra
POSTGRES_PASSWORD=请设置一个随机长密码
POSTGRES_PORT=54329

# 首次运行 npm run docker:prepare 后自动补充以下角色、随机密码及宿主机 UID/GID。
# APP_UID=
# APP_GID=
# POSTGRES_MIGRATOR_USER=
# POSTGRES_MIGRATOR_PASSWORD=
# POSTGRES_RUNTIME_USER=
# POSTGRES_RUNTIME_PASSWORD=
# POSTGRES_BACKUP_USER=
# POSTGRES_BACKUP_PASSWORD=

# 只备份 PostgreSQL 数据库，不备份上传文件。默认每天一次，保留 30 天。
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Application database pool and query limits
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=3000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=500

# Docsaid MRZ sidecar 地址（主应用与 sidecar 需加入同一个 Docker 网络）。
MRZ_SIDECAR_URL=http://mrzscanner_poc:8080
# 按官方默认值关闭中心裁切与后处理；需要时可单独改为 1 进行对比测试。
MRZ_CENTER_CROP=0
MRZ_POSTPROCESS=0
# MRZ 单 worker 串行推理，不设置容器 CPU 配额；内存上限保留保护。
MRZ_SIDECAR_MEM_LIMIT=1536m
MRZ_QUEUE_SIZE=3
MRZ_MAX_QUEUE_BYTES=104857600
MRZ_MAX_FILE_BYTES=20971520
MRZ_SCAN_TIMEOUT_SECONDS=60
