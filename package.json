{
  "name": "immigration-order-manager",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:docker": "DEPLOY_TARGET=docker next build --webpack",
    "start:docker": "APP_DEPLOYMENT=docker node .next/standalone/server.js",
    "start": "next start",
    "docker:prepare": "node scripts/prepare-docker-env.mjs",
    "mrz:sidecar:bench": "node scripts/benchmark-mrz-sidecar.mjs",
    "test": "npm run lint && npm run build:docker && node --test tests/permissions.test.mjs tests/order-action-policy.test.mjs tests/data-resource-policy.test.mjs tests/audit-coverage.test.mjs tests/cash-calculation.test.mjs tests/file-streaming.test.mjs tests/mrz-parser.test.mjs",
    "test:integration": "node scripts/require-integration-env.mjs && node --test tests/docker-smoke.test.mjs tests/postgres-constraints.test.mjs tests/low-resource.integration.test.mjs",
    "test:browser": "node tests/search-refresh.browser.cjs",
    "test:backup": "node --test tests/backup-scripts.test.mjs tests/file-integrity-script.test.mjs",
    "files:check": "node scripts/check-file-integrity.mjs",
    "files:hash-backfill": "node scripts/backfill-file-checksums.mjs",
    "deployment:verify": "./scripts/verify-deployment-security.sh",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/ocr --ignore-pattern public/pdf"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "busboy": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "mrz": "^5.0.2",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "pinyin-pro": "3.27.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/busboy": "^1.5.4",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "type": "module",
  "displayName": "MIGRA 移民订单管理系统"
}
